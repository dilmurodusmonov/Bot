BOT_TOKEN=123456:ABC-your-telegram-bot-token
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Ehsonlar e'lon qilinadigan kanal (bot kanalda admin bo'lishi kerak).
# Bo'sh qoldirilsa kanalga post qilinmaydi.
CHANNEL_ID=@ehsonli_qollar
# @BotFather /newapp da berilgan Mini App qisqa nomi
MINI_APP_SHORT_NAME=app
# Render bepul tarifida server uxlamasligi uchun (test xizmatida 0 qo'ying)
KEEP_AWAKE=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Reklama to'lovi (kartaga o'tkazma + chek). Chekni tasdiqlovchi adminlar
# Telegram ID'lari vergul bilan; ular botga /start bosgan bo'lishi kerak.
AD_CARD_NUMBER=8600000000000000
AD_CARD_HOLDER=ISM FAMILIYA
AD_ADMIN_IDS=123456789

# Instagram rasmiy API (ixtiyoriy): reklama beruvchilarning Instagram profilini topish
IG_GRAPH_TOKEN=
IG_BUSINESS_ID=
# Instagram so'rovlari uchun proksi(lar), vergul bilan (ixtiyoriy): http://user:pass@host:port
INSTAGRAM_PROXY=
